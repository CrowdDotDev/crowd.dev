DESCRIPTION >
    Compacts activities from same issue into one, keeping necessary information in a single row. Helps to serve issue-wide widgets in the development tab.
    Opened and closed events are unfiltered, so issues opened or closed by bots (e.g. stale bots) are included, the same way
    `pull_requests_analyzed` includes bot activity. Issues are still limited to enabled repositories, matching the cleaned buckets.
    The unfiltered buckets are refreshed once a day, so `issue_events` adds the hourly deltas the daily bucket merge has not taken in
    yet, using the same delta rule as `activityRelations_snapshot_merger_copy_0..2`. This keeps issues as fresh as the hourly
    cleaned buckets.
    The first non-author response still comes from the bot-filtered `activityRelations_deduplicated_cleaned_bucket_union`, so an
    automated bot comment does not count as a response.

NODE issue_events_delta
DESCRIPTION >
    Issue opened and closed events from the realtime MV that the daily bucket merge has not taken in yet: per bucket, rows with
    snapshotId at or after that bucket's latest snapshot, keeping the most recently updated version of each activity.

SQL >
    WITH
        (
            SELECT max(snapshotId) FROM activityRelations_enriched_deduplicated_bucket_0_ds
        ) AS bucket0Snapshot,
        (
            SELECT max(snapshotId) FROM activityRelations_enriched_deduplicated_bucket_1_ds
        ) AS bucket1Snapshot,
        (
            SELECT max(snapshotId) FROM activityRelations_enriched_deduplicated_bucket_2_ds
        ) AS bucket2Snapshot
    SELECT
        activityId,
        sourceId,
        sourceParentId,
        timestamp,
        segmentId,
        channel,
        platform,
        memberId,
        organizationId,
        type
    FROM activityRelations_enrich_snapshot_MV_ds
    WHERE
        type IN ('issues-opened', 'issues-closed')
        AND snapshotId >= multiIf(
            cityHash64(segmentId) % 3 = 0,
            bucket0Snapshot,
            cityHash64(segmentId) % 3 = 1,
            bucket1Snapshot,
            bucket2Snapshot
        )
    ORDER BY updatedAt DESC
    LIMIT 1 BY segmentId, timestamp, type, platform, channel, sourceId

NODE issue_events
DESCRIPTION >
    Issue opened and closed events: the daily unfiltered buckets, with any activity that has a newer version in the delta replaced
    by that version. Matches on activityId: a tuple NOT IN over every issue event is several times slower.

SQL >
    SELECT
        activityId,
        sourceId,
        sourceParentId,
        timestamp,
        segmentId,
        channel,
        platform,
        memberId,
        organizationId,
        type
    FROM activityRelations_enriched_deduplicated_bucket_union
    WHERE
        type IN ('issues-opened', 'issues-closed')
        AND activityId NOT IN (SELECT activityId FROM issue_events_delta)
    UNION ALL
    SELECT *
    FROM issue_events_delta

NODE issues_opened
SQL >
    SELECT
        activityId as id,
        sourceId,
        timestamp AS openedAt,
        segmentId,
        lower(channel) AS channel,
        platform,
        memberId,
        organizationId
    FROM issue_events
    WHERE
        type = 'issues-opened'
        AND toYear(timestamp) >= 1971
        AND (
            (
                platform IN ('git', 'gerrit', 'github', 'gitlab')
                AND (lower(channel), segmentId)
                IN (SELECT lower(channel), segmentId FROM repos_to_channels)
            )
            OR platform NOT IN ('git', 'gerrit', 'github', 'gitlab')
        )

NODE issues_closed
SQL >
    SELECT sourceParentId, MIN(timestamp) AS closedAt
    FROM issue_events
    WHERE type = 'issues-closed' AND sourceParentId != '' AND toYear(timestamp) >= 1971
    GROUP BY sourceParentId

NODE issues_comment_non_author
SQL >
    SELECT c.sourceParentId, MIN(c.timestamp) AS respondedAt
    FROM activityRelations_deduplicated_cleaned_bucket_union c
    INNER JOIN issues_opened opened ON c.sourceParentId = opened.sourceId
    WHERE
        c.type = 'issue-comment'
        AND c.sourceParentId != ''
        AND c.memberId != ''
        AND opened.memberId != ''
        AND c.memberId != opened.memberId
        AND toYear(c.timestamp) >= 1971
    GROUP BY c.sourceParentId

NODE issue_analysis_results_merged
SQL >
    SELECT
        opened.id,
        opened.sourceId,
        opened.segmentId as segmentId,
        opened.channel,
        opened.platform,
        opened.memberId,
        opened.organizationId,
        opened.openedAt,
        IF(
            comment_non_author.respondedAt = toDateTime(0), NULL, comment_non_author.respondedAt
        ) AS commentedAt,
        IF(closed.closedAt = toDateTime(0), NULL, closed.closedAt) AS closedAt,
        IF(
            closedAt IS NULL,
            NULL,
            toUnixTimestamp(toDateTime(closed.closedAt)) - toUnixTimestamp(toDateTime(opened.openedAt))
        ) AS closedInSeconds,
        IF(
            commentedAt IS NULL,
            NULL,
            toUnixTimestamp(toDateTime(comment_non_author.respondedAt))
            - toUnixTimestamp(toDateTime(opened.openedAt))
        ) AS respondedInSeconds
    FROM issues_opened opened
    LEFT JOIN issues_closed AS closed ON opened.sourceId = closed.sourceParentId
    LEFT JOIN
        issues_comment_non_author AS comment_non_author
        ON opened.sourceId = comment_non_author.sourceParentId

TYPE COPY
TARGET_DATASOURCE issues_analyzed
COPY_MODE replace
COPY_SCHEDULE 20 * * * *
